generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

model User {
  id               String             @id @default(uuid())
  email            String             @unique
  firstName        String
  lastName         String
  role             Role               @default(USER)
  authProvider     AuthProvider       @default(EMAIL)
  password         String?
  avatar           String?
  applications     Application[]
  Application_2026 Application_2026[]
  judge            Judge?
  projects         Project[]          @relation("ProjectToUser")
}

model Application {
  id                String  @id @default(uuid())
  gender            String
  age               Int
  ethnicity         String
  gradYear          Int
  phoneNumber       String
  school            String
  city              String
  state             String
  country           String
  educationLevel    String
  major             String
  diet              String
  shirtSize         String
  sleep             Boolean
  github            String
  linkedin          String
  portfolio         String
  whyBostonhacks    String
  userId            String
  applicationYear   Int
  status            Status  @default(PENDING)
  resumeUrl         String
  pronouns          String
  authorizeMLHEmail Boolean @default(false)
  user              User    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([applicationYear])
  @@index([status])
  @@index([applicationYear, status])
}

model Project {
  id            String   @id @default(uuid())
  name          String
  description   String
  repositoryUrl String
  technologies  String[]
  year          Int
  track         String?
  demoUrl       String?
  devpostUrl    String?
  teamName      String
  isWinner      Boolean  @default(false)
  prizeWon      String?
  placement     Int?
  scores        Score[]
  members       User[]   @relation("ProjectToUser")

  @@index([year])
  @@index([isWinner])
  @@index([year, isWinner])
  @@index([track])
  @@index([placement])
}

model Judge {
  id         String   @id @default(uuid())
  userId     String   @unique
  accessCode String   @unique
  tracks     String[] @default(["all"])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  year       Int?
  user       User     @relation(fields: [userId], references: [id])
  scores     Score[]

  @@index([year])
  @@index([accessCode])
}

model Score {
  id         String   @id @default(uuid())
  judgeId    String
  projectId  String
  scoreData  Json
  comments   String?
  totalScore Float    @default(0.0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  judge      Judge    @relation(fields: [judgeId], references: [id])
  project    Project  @relation(fields: [projectId], references: [id])

  @@unique([judgeId, projectId])
  @@index([totalScore])
  @@index([judgeId])
  @@index([projectId])
  @@index([createdAt])
}

model JudgingCriteria {
  id           String   @id @default(uuid())
  year         Int
  event        String   @default("BostonHacks")
  criteriaList Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([year, event])
  @@index([year])
  @@index([event])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model Application_2026 {
  id                String  @id
  gender            String
  age               Int
  ethnicity         String
  gradYear          Int
  phoneNumber       String
  school            String
  city              String
  state             String
  country           String
  educationLevel    String
  major             String
  diet              String
  shirtSize         String
  sleep             Boolean
  github            String
  linkedin          String
  portfolio         String
  whyBostonhacks    String
  userId            String
  applicationYear   Int
  status            Status  @default(PENDING)
  resumeUrl         String
  pronouns          String
  authorizeMLHEmail Boolean @default(false)
  User              User    @relation(fields: [userId], references: [id])

  @@index([applicationYear])
  @@index([applicationYear, status])
  @@index([status])
  @@index([userId])
}

enum Role {
  USER
  ADMIN
}

enum Status {
  PENDING
  ACCEPTED
  WAITLISTED
  REJECTED
  CONFIRMED
  DECLINED
}

enum AuthProvider {
  EMAIL
  FACEBOOK
  GOOGLE
}
